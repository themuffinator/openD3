# Auto detect text files and perform LF normalization
*.sh text eol=lf
* text=auto
# Meson applies dependency patches to LF files from upstream source archives.
# Unified-diff context prefixes legitimately precede source tabs and blank lines.
*.patch text eol=lf -whitespace
# Runtime pack sources are packed byte for byte and every platform must build
# identical packs, so their checkout keeps the repository bytes: no end-of-line
# conversion, whatever core.autocrlf says.
content/baseod3/** -text

# Preserve byte-stable legacy and generated idTech content. These authoring formats
# commonly emit trailing spaces and mixed indentation as part of their source data.
content/baseod3/pak0/** -whitespace


# Licence texts shipped as RTF are retained byte-for-byte, CRLF included.
LICENSES/*.rtf -text
