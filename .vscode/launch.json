{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch OpenD3 MP (Meson Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\.install\\OpenD3-client_x64.exe",
      "args": [
        "+set",
        "logFile",
        "2",
        "+set",
        "logFileName",
        "logs/opend3.log",
        "+set",
        "developer",
        "1",
        "+set",
        "r_fullscreen",
        "0",
        "+set",
        "fs_basepath",
        "\"C:\\Program Files (x86)\\Steam\\steamapps\\common\\Doom 3\"",
        "+set",
        "fs_savepath",
        "${workspaceFolder}\\.home",
        "+set",
        "fs_devpath",
        "${workspaceFolder}\\.install",
        "+set",
        "fs_game",
        "opend3",
        "+set",
        "net_serverDedicated",
        "0",
        "+seta",
        "si_pure",
        "0",
        "+set",
        "net_serverAllowServerMod",
        "1",
        "+set",
        "sv_cheats",
        "1",
        "+set",
        "si_gameType",
        "DM",
        "+set",
        "si_pure",
        "0",
        "+spawnServer",
        "game/mp/d3dm1"
      ],
      "cwd": "${workspaceFolder}\\.install",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch OpenD3 SP (Meson Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\.install\\OpenD3-client_x64.exe",
      "args": [
        "+set",
        "logFile",
        "2",
        "+set",
        "logFileName",
        "logs/opend3.log",
        "+set",
        "developer",
        "1",
        "+set",
        "com_skipLoadingContinue",
        "1",
        "+set",
        "r_fullscreen",
        "0",
        "+set",
        "fs_basepath",
        "\"C:\\Program Files (x86)\\Steam\\steamapps\\common\\Doom 3\"",
        "+set",
        "fs_savepath",
        "${workspaceFolder}\\.home",
        "+set",
        "fs_devpath",
        "${workspaceFolder}\\.install",
        "+set",
        "fs_game",
        "opend3",
        "+set",
        "si_gameType",
        "singleplayer",
        "+map",
        "game/mars_city1"
      ],
      "cwd": "${workspaceFolder}\\.install",
      "console": "integratedTerminal"
    }
  ]
}
