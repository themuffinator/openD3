#!/bin/sh

export OPEND3_STEAMDECK="${OPEND3_STEAMDECK:-1}"

if [ "${OPEND3_FORCE_X11:-0}" = "1" ]; then
	export SDL_VIDEO_DRIVER=x11
	export SDL_VIDEODRIVER=x11
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec "$SCRIPT_DIR/@OPEND3_CLIENT_BINARY@" +set com_platformProfile steamdeck "$@"
